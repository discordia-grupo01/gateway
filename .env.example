# Tiene que ser EL MISMO valor que el JWT_SECRET de identity/servers, en sus
# propias VMs -- si no coincide, Kong rechaza todos los tokens.
JWT_SECRET=

# Dominio publico (Paso 3 del README de infrastructure/deploy).
DOMAIN=tunombre.duckdns.org

# IP de Tailscale de cada VM, puerto 8080. Las VMs tienen que estar en la
# misma red de Tailscale antes de que esto funcione (`tailscale up`).
IDENTITY_UPSTREAM_URL=http://100.x.y.z:8080
SERVERS_UPSTREAM_URL=http://100.x.y.z:8080
MESSAGING_UPSTREAM_URL=http://100.x.y.z:4000
NOTIFICATIONS_UPSTREAM_URL=http://100.x.y.z:4000
VOICE_UPSTREAM_URL=http://100.x.y.z:4000
# discordia-admin (backoffice API). Obligatoria: si queda vacia, el render
# deja una URL invalida y Kong no arranca. PENDIENTE
ADMIN_UPSTREAM_URL=http://100.x.y.z:8080
METRICS_UPSTREAM_URL=http://100.x.y.z:8080
# discordia-billing (puntos y Premium con Mercado Pago). Si queda vacia, Kong
# arranca igual y las rutas de billing responden 502.
BILLING_UPSTREAM_URL=http://100.x.y.z:8080
# Dominio de la web, con esquema y sin barra final: es el unico que puede subir
# adjuntos directo desde el navegador (CORS).
WEB_ORIGIN=https://tu-proyecto.vercel.app
