# Tiene que ser EL MISMO valor que el JWT_SECRET de identity/servers, en sus
# propias VMs -- si no coincide, Kong rechaza todos los tokens.
JWT_SECRET=

# Dominio publico (Paso 3 del README de infrastructure/deploy).
DOMAIN=tunombre.duckdns.org

# IP de Tailscale de cada VM, puerto 8080. Las VMs tienen que estar en la
# misma red de Tailscale antes de que esto funcione (`tailscale up`).
IDENTITY_UPSTREAM_URL=http://100.x.y.z:8080
SERVERS_UPSTREAM_URL=http://100.x.y.z:8080
