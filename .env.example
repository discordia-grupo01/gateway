# Tiene que ser EL MISMO valor que el JWT_SECRET de identify-service, en sus
# propias VMs: si no coincide, Kong rechaza todos los tokens. El valor de
# ejemplo sirve solo para correr en local.
JWT_SECRET=secreto-jwt-solo-local

# Dominio publico, solo para el perfil "https" (Caddy).
DOMAIN=tunombre.duckdns.org

# Donde escucha cada servicio. En local, desde el contenedor de Kong, tu maquina
# es host.docker.internal. En produccion son las IPs de Tailscale de cada VM.
IDENTITY_UPSTREAM_URL=http://host.docker.internal:8080
SERVERS_UPSTREAM_URL=http://host.docker.internal:8081
MESSAGING_UPSTREAM_URL=http://host.docker.internal:4000
NOTIFICATIONS_UPSTREAM_URL=http://host.docker.internal:4001
VOICE_UPSTREAM_URL=http://host.docker.internal:4002
ADMIN_UPSTREAM_URL=http://host.docker.internal:8082
METRICS_UPSTREAM_URL=http://host.docker.internal:8083
BILLING_UPSTREAM_URL=http://host.docker.internal:8084

# Dominio de la web, con esquema y sin barra final: es el unico que puede subir
# adjuntos directo desde el navegador (CORS).
WEB_ORIGIN=http://localhost:3000

# IP en la que Kong publica el puerto 8000. Por defecto, solo tu maquina.
# GATEWAY_BIND_IP=127.0.0.1

# Trazas de Kong hacia New Relic (opcional). Sin endpoint y api-key, Kong
# arranca igual y no exporta nada. La api-key es la misma de los otros servicios.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=LA_CLAVE_DE_LICENCIA_DE_INGESTA
# OTEL_SERVICE_NAME=gateway-prod
# Logs de Kong hacia New Relic (opcional). La api-key sale de OTEL_EXPORTER_OTLP_HEADERS
# salvo que se defina LOG_SHIP_API_KEY.
# LOG_SHIP_URL=https://log-api.newrelic.com/log/v1
# LOG_SHIP_API_KEY=
