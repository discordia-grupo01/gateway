# "{vault://env/...}" para esto (probado), asi que este archivo se renderiza
# con `envsubst` ANTES de que Kong arranque -- ver infrastructure/deploy/.
_format_version: "3.0"

services:
  - name: identity-public
    url: ${IDENTITY_UPSTREAM_URL}
    routes:
      - name: identity-register
        paths: ["/v1/users"]
        methods: ["POST"]
        strip_path: false
      - name: identity-login
        paths: ["/v1/login"]
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              # identify-service ya bloquea fuerza bruta por (email, ip)
              # (AuthService.Login / WithLoginAttempts); esto solo protege
              # contra volumen/DoS por IP, asi que puede ser mas alto sin
              # dejar de proteger nada -- 10/min bloqueaba a cualquier grupo
              # de usuarios legitimos compartiendo una IP. Ver
              # infrastructure/load-test/README.md.
              minute: 60
              policy: local
      - name: identity-email-confirmation
        paths: ["/v1/email-confirmation"]
        methods: ["POST"]
        strip_path: false
      - name: identity-email-confirmation-confirm
        paths: ["/v1/email-confirmation/confirm"]
        methods: ["POST"]
        strip_path: false
      - name: identity-pin-login
        paths: ["/v1/pin/login"]
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 10
              policy: local
      - name: identity-oauth-google
        paths: ["/v1/oauth/google"]
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 10
              policy: local
      - name: identity-oauth-mobile-callback
        paths: ["/oauth/mobile-callback"]
        methods: ["GET"]
        strip_path: false
      - name: identity-password-recovery
        paths: ["/v1/password-recovery"]
        methods: ["POST"]
        strip_path: false
      - name: identity-password-reset
        paths: ["/v1/password-reset"]
        methods: ["POST"]
        strip_path: false
      - name: identity-profile-image
        paths: ["/uploads/profile-images"]
        methods: ["GET"]
        strip_path: false
      - name: identity-refresh
        paths: ["/v1/refresh"]
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: rate-limiting
            config:
              minute: 10
              policy: local

  - name: identity-auth
    url: ${IDENTITY_UPSTREAM_URL}
    routes:
      - name: identity-pin-configure
        paths: ["/v1/pin"]
        methods: ["POST"]
        strip_path: false
      - name: identity-logout
        paths: ["/v1/logout"]
        methods: ["POST"]
        strip_path: false
      - name: identity-profile-me
        paths: ["/v1/me"]
        methods: ["GET", "PATCH", "PUT", "DELETE"]
        strip_path: false
      - name: identity-profile-public
        paths: ["/v1/users"]
        methods: ["GET"]
        strip_path: false
      - name: identity-two-factor-status
        paths: ["/v1/me/2fa"]
        methods: ["GET"]
        strip_path: false
      - name: identity-two-factor-setup
        paths: ["/v1/me/2fa/setup"]
        methods: ["POST"]
        strip_path: false
      - name: identity-two-factor-activate
        paths: ["/v1/me/2fa/activate"]
        methods: ["POST"]
        strip_path: false
      - name: identity-two-factor-disable
        paths: ["/v1/me/2fa/disable"]
        methods: ["POST"]
        strip_path: false
      - name: identity-two-factor-recovery-codes
        paths: ["/v1/me/2fa/recovery-codes"]
        methods: ["POST"]
        strip_path: false
      - name: identity-set-password
        paths: ["/v1/me/password"]
        methods: ["POST"]
        strip_path: false
    plugins:
      - name: jwt
        config:
          claims_to_verify: ["exp"]

  - name: servers-public
    url: ${SERVERS_UPSTREAM_URL}
    routes:
      - name: servers-icon
        paths:
          - "~/v1/servers/[^/]+/icon$"
        methods: ["GET"]
        strip_path: false
      - name: servers-banner
        paths:
          - "~/v1/servers/[^/]+/banner$"
        methods: ["GET"]
        strip_path: false

  - name: servers-service
    url: ${SERVERS_UPSTREAM_URL}
    routes:
      - name: servers-routes
        paths:
          - /v1/servers
          - /v1/channels
          - /v1/categories
          - /v1/invites
          - /v1/roles
          - /v1/members
        strip_path: false
    plugins:
      - name: jwt
        config:
          claims_to_verify: ["exp"]

  - name: voice-signaling
    url: ${VOICE_UPSTREAM_URL}
    routes:
      - name: voice-token
        paths: ["/api/voice/token"]
        methods: ["POST"]
        strip_path: false
      - name: voice-session-leave
        paths: ["/api/voice/session"]
        methods: ["DELETE"]
        strip_path: false
    plugins:
      - name: jwt
        config:
          claims_to_verify: ["exp"]

  - name: messaging-service
    url: ${MESSAGING_UPSTREAM_URL}
    routes:
      - name: messaging-routes
        paths:
          - "~/v1/channels/[^/]+/messages$"
        methods: ["GET"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-message
        paths:
          - "~/v1/channels/[^/]+/messages/[^/]+$"
        methods: ["PATCH", "DELETE"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-conversations
        paths:
          - "~/v1/conversations$"
        methods: ["GET"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-conversation-read
        paths:
          - "~/v1/conversations/[^/]+/read$"
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-blocks
        paths:
          - "~/v1/blocks$"
        methods: ["GET", "POST"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-block
        paths:
          - "~/v1/blocks/[^/]+$"
        methods: ["DELETE"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-mentions
        paths:
          - "~/v1/mentions$"
        methods: ["GET"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-channel-mentions-read
        paths:
          - "~/v1/channels/[^/]+/mentions/read$"
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-socket-tickets
        paths: ["/v1/socket-tickets"]
        methods: ["POST"]
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify: ["exp"]
      - name: messaging-socket
        paths: ["/socket"]
        strip_path: false
consumers:
  - username: discordia-users
    jwt_secrets:
      - key: discordia-issuer
        algorithm: HS256
        secret: '${JWT_SECRET}'
